#!/usr/bin/env bash
# platforms: linux
# Run one command with the human's secrets loaded into that command only.
# Nothing persists: the secrets exist for this process tree and are gone when
# the command exits. Use it in any workspace.
#
#   with-secrets discli message send "#admin-commands" "hi"
#   with-secrets postman workspace list
#   with-secrets curl -s "$SOME_URL" -H "Authorization: Bearer $SOME_TOKEN"
set -euo pipefail

DEV_SETUP=/mnt/d/dev/simpsonm09/projects/repos/simpsonm09-dev-setup
# Pass the env file explicitly so the loader does not pick up this script's args.
source "$DEV_SETUP/wsl/load-secrets.sh" "$DEV_SETUP/settings/.env" >/dev/null

exec "$@"
