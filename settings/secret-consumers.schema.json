{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Value-free broker consumer declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["consumers", "agentEnvironmentAllowlist"],
  "properties": {
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "brokerIdentity", "bundle", "credentialNames", "operations"],
        "properties": {
          "consumer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "brokerIdentity": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,47}$" },
          "bundle": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "credentialNames": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["discord-request", "postman-request", "notification-send", "sms-send", "mail-read", "mail-send", "github-approved-operation", "sign", "gateway-start"]
            }
          }
        }
      }
    },
    "agentEnvironmentAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["LANG", "LC_ALL", "TERM", "NO_COLOR", "FORCE_COLOR", "TZ"] }
    }
  }
}
