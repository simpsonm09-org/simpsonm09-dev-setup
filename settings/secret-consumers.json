    { "consumer": "signing", "brokerIdentity": "Signing-Runner", "bundle": "signing", "credentialNames": ["SIGNING_PRIVATE_KEY"], "operations": ["sign"] },
    { "consumer": "model-gateway", "brokerIdentity": "Gateway-Operator", "bundle": "model-gateway", "credentialNames": ["DEEPSEEK_API_KEY", "LITELLM_MASTER_KEY", "POSTGRES_PASSWORD"], "operations": ["gateway-start"] }
