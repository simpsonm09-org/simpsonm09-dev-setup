{
  "consumers": [
    { "consumer": "agent-discord", "brokerIdentity": "Agent-Vault-Runner", "bundle": "discord", "credentialNames": ["DISCORD_BOT_TOKEN"], "operations": ["discord-request"] },
    { "consumer": "human-discord", "brokerIdentity": "Human-Vault-Runner", "bundle": "discord", "credentialNames": ["DISCORD_BOT_TOKEN"], "operations": ["discord-request"] },
    { "consumer": "agent-postman", "brokerIdentity": "Agent-Vault-Runner", "bundle": "postman", "credentialNames": ["POSTMAN_API_KEY"], "operations": ["postman-request"] },
    { "consumer": "human-postman", "brokerIdentity": "Human-Vault-Runner", "bundle": "postman", "credentialNames": ["POSTMAN_API_KEY"], "operations": ["postman-request"] },
    { "consumer": "notifications", "brokerIdentity": "Notification-Runner", "bundle": "notifications", "credentialNames": ["NTFY_TOKEN", "NTFY_TOPIC"], "operations": ["notification-send"] },
    { "consumer": "sms", "brokerIdentity": "SMS-Runner", "bundle": "sms", "credentialNames": ["SMS_GATEWAY_USER", "SMS_GATEWAY_PASSWORD"], "operations": ["sms-send"] },
