# Bootstrap for `with-secrets`. Keep this file local and gitignored.
# Run `just secrets-init`, then fill in the store unlock fields for online use.
# The wrapper never loads this file into your shell.

INFISICAL_DOMAIN=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# Optional offline values. The wrapper uses them only with `--offline`.
# FALLBACK_KEY=

# Agent Vault uses separate role configs outside this repository.
