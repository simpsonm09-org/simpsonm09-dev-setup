# Copy to .env (same directory) and fill in. .env is gitignored.
#
# One file works for both runtimes at this path:
#   Windows: D:\dev\simpsonm09\projects\repos\simpsonm09-dev-setup\settings\.env
#   WSL:     /mnt/d/dev/simpsonm09/projects/repos/simpsonm09-dev-setup/settings/.env
#
# Infisical is the source of truth for the integration secrets. This file holds
# the machine identity that unlocks the project and the non-secret personal
# values, including PII. WSL loads it through the workspace .envrc, Windows
# through scripts/Import-Secrets.ps1, and both export every key here that is not
# prefixed INFISICAL_, then overlay the Infisical export. See docs/secrets.md.

# Infisical instance and project. The project id is in the project URL, the
# segment after /projects/secret-management/.
INFISICAL_DOMAIN=http://localhost:8088
INFISICAL_ENV=dev
INFISICAL_PROJECT_ID=

# Universal Auth machine identity. Create a client secret on the identity's
# Universal Auth page in Infisical. It is shown once.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# Non-secret personal values. The loaders export these; an Infisical key of the
# same name overrides the value here. Leave a value blank to skip it.
VAULT_ADDR=
VAULT_NAMESPACE=
JIRA_SITE=
JIRA_PROJECT=
JENKINS_URL=
JENKINS_USER=
POSTMAN_WORKSPACE=
GMAIL_ADDRESS=
SMS_GATEWAY_HOST=
