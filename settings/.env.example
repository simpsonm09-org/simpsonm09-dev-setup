# Copy to .env (same directory) and fill in. .env is gitignored.
#
# One file works for both runtimes at this path:
#   Windows: D:\dev\simpsonm09\projects\repos\simpsonm09-dev-setup\settings\.env
#   WSL:     /mnt/d/dev/simpsonm09/projects/repos/simpsonm09-dev-setup/settings/.env
#
# Infisical is the source of truth. This file holds only the machine identity
# that unlocks the project and a small offline fallback. The credentials live in
# the /secrets folder and the PII and person or machine config live in the /pii
# folder of the project's dev environment. WSL loads this file through the
# workspace .envrc, Windows through scripts/Import-Secrets.ps1, and both overlay
# the /secrets and /pii export on top. See docs/secrets.md.

# Infisical instance and project. The project id is in the project URL, the
# segment after /projects/secret-management/.
INFISICAL_DOMAIN=http://localhost:8088
INFISICAL_ENV=dev
INFISICAL_PROJECT_ID=

# Universal Auth machine identity. Create a client secret on the identity's
# Universal Auth page in Infisical. It is shown once.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# Offline fallback. Add a KEY=VALUE here only for a value you need while
# Infisical is unreachable. The loaders export every key here that is not
# prefixed INFISICAL_, then overlay the /secrets and /pii export, so an
# Infisical key of the same name wins. Keep this empty when Infisical is up.
# FALLBACK_KEY=
