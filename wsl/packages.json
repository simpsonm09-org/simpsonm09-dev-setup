{
  "ubuntuRelease": "26.04",
  "aptPackages": [
    "git",
    "curl",
    "ca-certificates",
    "unzip",
    "gnupg",
    "gh"
  ],
  "optionalAptProfiles": {
    "dockerEngine": [
      "docker-ce",
      "docker-ce-cli",
      "containerd.io",
      "docker-buildx-plugin",
      "docker-compose-plugin"
    ]
  },
  "snapPackages": [
    {
      "id": "terminal",
      "package": "ghostty",
      "classic": true
    }
  ],
  "npmPackages": [
    {
      "id": "postman-cli",
      "package": "postman-cli"
    },
    {
      "id": "newman",
      "package": "newman"
    },
    {
      "id": "infisical",
      "package": "@infisical/cli"
    },
    {
      "id": "playwright-cli",
      "package": "@playwright/cli"
    },
    {
      "id": "chrome-devtools",
      "package": "chrome-devtools"
    },
    {
      "id": "ctx7",
      "package": "ctx7"
    }
  ],
  "packagePolicy": "latest from configured apt sources",
  "manualTools": {
    "opencode": {
      "url": null,
      "note": "Install from the official V2 command; credentials stay in local auth storage.",
      "observedVersion": "2.0.18",
      "updateCommand": "opencode upgrade",
      "managedByBootstrap": false
    },
    "mise": {
      "url": "https://mise.jdx.dev/installing-mise.html",
      "note": null,
      "observedVersion": null,
      "updateCommand": null,
      "managedByBootstrap": false
    },
    "trivy": {
      "url": "https://trivy.dev/latest/docs/installation/",
      "note": null,
      "observedVersion": null,
      "updateCommand": null,
      "managedByBootstrap": false
    }
  },
  "deferredTools": [
    {
      "id": "docker",
      "label": "apt `docker-ce, docker-ce-cli, containerd.io, docker-buildx-plugin, docker-compose-plugin`"
    }
  ]
}
