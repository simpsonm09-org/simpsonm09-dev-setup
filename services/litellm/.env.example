# Non-secret settings only. Copy to .env on the broker host.
# Replace with the Docker Desktop host's RFC1918 IPv4 interface, not 0.0.0.0.
LITELLM_BIND_ADDRESS=HOMELAB_PRIVATE_IPV4
LITELLM_PORT=4000
# Configure llama.cpp with --alias local-qwen; this address is container-relative.
LOCAL_LLAMA_BASE_URL=http://host.docker.internal:8080/v1
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.2@sha256:7294b90f868c5c38c99b83021c7ba46f9b439e95f8e32964c925c7d2563a03f7
POSTGRES_IMAGE=postgres:16.10-alpine3.22@sha256:029660641a0cfc575b14f336ba448fb8a75fd595d42e1fa316b9fb4378742297
